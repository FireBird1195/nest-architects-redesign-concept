---
import { drawings, render } from '../lib/sketch.js';

interface Props {
  name: keyof typeof drawings;
  label?: string;
  class?: string;
  weight?: number;
  animate?: boolean;
}
const { name, label, class: cls = '', weight = 1.6, animate = true } = Astro.props;
const d = drawings[name];
const { paths, texts } = render(d.prims, d.seed, d.opts);
const step = Math.min(0.03, 1.6 / paths.length);
---

<svg
  class:list={['sketch', cls, { 'sketch--draw': animate }]}
  viewBox={`0 0 ${d.box[0]} ${d.box[1]}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  style={`--w:${weight}`}
  fill="none"
>
  {
    paths.map((p, i) => (
      <path class={`sk-${p.cls}`} d={p.d} pathLength="1" style={`--d:${(i * step).toFixed(3)}s`} />
    ))
  }
  {texts.map((t) => <text class="sk-t" x={t.x} y={t.y} text-anchor={t.anchor}>{t.s}</text>)}
</svg>
