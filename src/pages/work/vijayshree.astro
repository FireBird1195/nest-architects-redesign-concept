---
import Base from '../../layouts/Base.astro';
import Sketch from '../../components/Sketch.astro';
import { url } from '../../lib/paths.js';
import Photo from '../../components/Photo.astro';
import { photos } from '../../lib/photos.js';

const home = url('/');
const rooms = [
  { id: 'lobby', name: 'The lobby', sketch: 'lobby', photos: [photos.lobbyTall, photos.lobbyWide],
    body: 'A double-height space with a mirrored ceiling and butterfly lighting, so that butterflies seem to surround you on the staircase. An artwork by Suruchi hangs on the lobby wall.' },
  { id: 'living', name: 'Living & dining', sketch: 'living', photos: [photos.livingAlt, photos.dining], stack: true,
    body: 'A rotating partition stands between the living and dining areas, keeping the two visually connected. The television unit is detailed so that the screen appears to float.' },
  { id: 'kitchen', name: 'The kitchen', sketch: 'kitchen', photos: [photos.kitchen],
    body: 'A minimalist white kitchen with an island table, connected to the dining area.' },
  { id: 'master', name: 'Master bedroom', sketch: 'bedroom', photos: [photos.master],
    body: 'A vintage-style mirror at the entrance, intricate carving at the bed-back in a platinum rustic finish, and rosy metallic wallpaper. Seating by the window is placed to take the north light.' },
  { id: 'grandparents', name: 'Grandparents’ room', sketch: 'elders', photos: [photos.eldersTall, photos.eldersWide],
    body: 'An exposed concrete finish behind the bed, louvered wooden strips, metal wall art and jute-textured wallpaper, with florals in the carpet and curtains. The published description calls it humble and raw.' },
  { id: 'family', name: 'Family room',
    body: 'A blue floor, cream sofas, a television unit clad in wooden mosaic, tall glass doors and a custom metallic wallpaper.' },
  { id: 'sons', name: 'The sons’ rooms', photos: [photos.sonYounger, photos.sonElder],
    body: 'One room has an ochre bed with pastel tints, birds on the ring and a piano in the corner. The elder son’s room is blue with teak wood beading, glass lights and a study corner.' },
  { id: 'terrace', name: 'Terrace garden', sketch: 'terrace', photos: [photos.terraceSwing, photos.terraceWide], stack: true,
    body: 'Rajwada-style seating, carved jalis, inlay tables and a vintage teak swing overlooking the garden.' },
];
const facts = [
  ['Place', 'West Nagpur, Maharashtra'],
  ['Completed', '2022'],
  ['Time on the project', 'Two years'],
  ['Plot', '6,000 sq ft'],
  ['Scope', 'Residence interior design'],
  ['Design', 'Nikita Tahilyani, Vikram Singhania'],
];
const makers = [
  ['Kitchen, wallpaper & hardware', 'Häfele'],
  ['Doors, partitions & finishes', 'Greenply'],
  ['Windows', 'Fenesta'],
  ['Sanitaryware', 'Jaquar'],
  ['Lighting', 'Philips'],
  ['Paint', 'Asian Paints'],
];
let plate = 0;
const isTall = (p) => p.h > p.w;
---

<Base
  title="Vijayshree, West Nagpur — Nest Architects (design concept)"
  description="A room-by-room walk through Vijayshree, a family bungalow interior in West Nagpur by NEST Architects, presented as part of an unofficial website concept."
  current="work"
>
  <article class="project">
    <header class="project__head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`${home}#work`}>Work</a><span aria-hidden="true">/</span><span>Homes</span>
      </nav>
      <h1 class="display display--xl">Vijayshree</h1>
      <p class="lede">
        A family bungalow in the west of Nagpur, fitted out room by room with furniture, doors, kitchens and floors
        made for the house.
      </p>
      <dl class="facts">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </header>

    <div class="project__lead">
      <Photo photo={photos.livingWide} eager class="project__lead-main" />
      <Photo photo={photos.heroLiving} eager class="project__lead-side" />
      <p class="plate-cap">The living room. Photographs: NEST Architects, shown from the studio's website.</p>
    </div>

    <section class="project__brief" aria-labelledby="brief-h">
      <div class="project__brief-art">
        <Sketch name="vHouse" weight={1.1} />
      </div>
      <div>
        <p class="eyebrow">The idea</p>
        <h2 id="brief-h" class="title">Traditional in spirit, <em>and made to measure.</em></h2>
        <p>
          The published account of the house describes a traditional style shaped by the owners' personality, and sums
          it up as “elegant with understated luxury”. Bespoke pieces were used throughout, for furniture, doors,
          kitchens and floors, so that each detail connects to the next.
        </p>
        <p>
          It is home to a couple, their sons and the grandparents. Each room has its own character while remaining
          part of one house.
        </p>
      </div>
    </section>

    <div class="walk">
      <nav class="walk__index" aria-label="Rooms">
        <p class="label">Walk through</p>
        <ol>
          {rooms.map((r, i) => <li><a href={`#${r.id}`} data-room-link><span>{String(i + 1).padStart(2, '0')}</span>{r.name}</a></li>)}
        </ol>
      </nav>
      <div class="walk__rooms">
        {
          rooms.map((r, i) => {
            const flip = r.photos && plate++ % 2 === 1;
            const solo = r.photos?.length === 1;
            return (
              <section class:list={['room', { 'room--plate': r.photos, 'room--flip': flip }]} id={r.id} aria-labelledby={`${r.id}-h`}>
                {r.photos && (
                  <div class:list={['room__media', { 'room__media--stack': r.stack, 'room__media--solo-tall': solo && isTall(r.photos[0]) }]}>
                    {r.photos.map((ph) => <Photo photo={ph} />)}
                  </div>
                )}
                <div class="room__copy" data-reveal>
                  {r.sketch && <div class="room__sketch"><Sketch name={r.sketch} weight={2.4} /></div>}
                  <p class="room__n">{String(i + 1).padStart(2, '0')}</p>
                  <h2 id={`${r.id}-h`}>{r.name}</h2>
                  <p>{r.body}</p>
                </div>
              </section>
            );
          })
        }
      </div>
    </div>

    <section class="makers" aria-labelledby="makers-h">
      <div>
        <p class="eyebrow">Made with</p>
        <h2 id="makers-h" class="title">Materials <em>&amp; makers</em></h2>
      </div>
      <dl>
        {makers.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p class="makers__pub">
        Project facts, room descriptions and suppliers as published in
        <a href="https://thearchitectsdiary.com/resurgence-of-traditional-design-elements-with-contemporary-elegance-nest-architects/" target="_blank" rel="noopener noreferrer">The Architects Diary, April 2022<span class="visually-hidden"> (opens in a new tab)</span></a>.
      </p>
    </section>

    <section class="next" aria-label="Continue">
      <a class="next__link" href={`${home}#work`}>
        <span class="eyebrow">Next</span>
        <span class="display">All projects <i aria-hidden="true">→</i></span>
      </a>
      <a class="next__link next__link--alt" href={`${home}#enquire`}>
        <span class="eyebrow">Planning a home of your own?</span>
        <span class="display">Start a conversation <i aria-hidden="true">→</i></span>
      </a>
    </section>
  </article>
</Base>
