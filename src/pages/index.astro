---
import Base from '../layouts/Base.astro';
import Sketch from '../components/Sketch.astro';
import { url } from '../lib/paths.js';
import { studio } from '../lib/studio.js';

const project = url('/work/vijayshree/');
const work = [
  { id: 'vijayshree', n: '01', name: 'Vijayshree', kind: 'Bungalow interior', place: 'West Nagpur', sketch: 'vHouse', href: project },
  { id: 'bungalow', n: '02', name: 'Luxury Bungalow', kind: 'Residence', place: 'Nagpur', sketch: 'vVilla' },
  { id: 'chandrapur', n: '03', name: 'Chandrapur Residential', kind: 'Residence', place: 'Chandrapur', sketch: 'vFlat' },
  { id: '4bhk', n: '04', name: '4BHK Residential Interior', kind: 'Apartment interior', place: 'Nagpur', sketch: 'vPlan' },
  { id: 'store', n: '05', name: 'Ethnic Cloth Store', kind: 'Retail interior', place: 'Nagpur', sketch: 'vShop' },
];
const sectors = [
  { name: 'Homes', note: 'Bungalows, apartments and the interiors that go inside them. Most of our work begins here.' },
  { name: 'Shops', note: 'Retail interiors and showrooms, such as an ethnic clothing store in Nagpur.' },
  { name: 'Offices', note: 'Corporate and commercial workplaces, planned around how the people in them work.' },
  { name: 'Hotels & restaurants', note: 'Hospitality spaces where the room has to earn its keep every evening.' },
  { name: 'Hospitals', note: 'Healthcare buildings, planned alongside the NABH consultants among our associates.' },
];
const steps = [
  { n: '1', title: 'We start with you', body: 'Every design is shaped around the people who will use it: how your family lives, how your staff work, what you want a visitor to feel at the door. The style follows from that, not the other way round.' },
  { n: '2', title: 'We plan it properly', body: 'Requirements are drawn out and resolved on paper first, with civil and structural designers involved where the building needs them, so the decisions are made before anything is ordered.' },
  { n: '3', title: 'We stay until it is finished', body: 'A site supervisor from our own team follows the work through, so what gets built is what was drawn, down to the detailing.' },
];
---

<Base
  title="Nest Architects — Architecture & interiors, Nagpur (design concept)"
  description="An unofficial website concept for NEST Architects, the Nagpur architecture and interior design studio led by Ar. Nikita Tahilyani and Ar. Vikram Singhania."
  current="home"
>
  <section class="hero">
    <div class="hero__copy">
      <p class="eyebrow">Architecture &amp; interiors · Nagpur</p>
      <h1 class="display">Drawn around the people who&nbsp;live&nbsp;there.</h1>
      <p class="lede">
        Nest is an architecture and interior design studio led by Ar.&nbsp;Nikita Tahilyani and Ar.&nbsp;Vikram
        Singhania. We design homes, shops, offices, hotels and hospitals, and stay with each one until it is built.
      </p>
      <div class="hero__actions">
        <a class="btn btn--solid" href="#work">See the work</a>
        <a class="link-arrow" href="#enquire">Tell us about your project</a>
      </div>
    </div>
    <div class="hero__art">
      <svg class="hero__ring" viewBox="0 0 400 400" aria-hidden="true"><circle cx="200" cy="200" r="186" /></svg>
      <Sketch name="section" weight={1.5} label="Hand-drawn section through a gabled house: rooms for living, a double-height lobby with a stair, and a swing on the terrace." />
    </div>
    <p class="hero__foot"><span>Re-design for the home we live in</span><span>Scroll</span></p>
  </section>

  <section class="work" id="work" aria-labelledby="work-h">
    <header class="section-head">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-h" class="title">Five projects, <em>one way of working.</em></h2>
    </header>
    <div class="work__body">
      <div class="work__pane" aria-hidden="true">
        {
          work.map((w, i) => (
            <div class:list={['work__plate', { 'is-active': i === 0 }]} data-work-pane={w.id}>
              <Sketch name={w.sketch} weight={1.3} animate={false} />
              <p class="plate-cap">Drawn stand-in · {w.name}</p>
            </div>
          ))
        }
      </div>
      <ol class="work__list">
        {
          work.map((w, i) => {
            const Tag = w.href ? 'a' : 'div';
            return (
              <li>
                <Tag class:list={['work__row', { 'is-active': i === 0, 'work__row--link': w.href }]} href={w.href} data-work-row={w.id} tabindex={w.href ? undefined : 0}>
                  <span class="work__n">{w.n}</span>
                  <span class="work__thumb" aria-hidden="true"><Sketch name={w.sketch} weight={2.2} animate={false} /></span>
                  <span class="work__name">{w.name}</span>
                  <span class="work__meta">{w.kind}<i class="sep" aria-hidden="true"> · </i><br />{w.place}</span>
                  <span class="work__go">{w.href ? <>Read the project <i aria-hidden="true">→</i></> : 'Story to follow'}</span>
                </Tag>
              </li>
            );
          })
        }
      </ol>
    </div>
    <p class="work__note">
      In this concept, one project is told in full. The other four are real Nest projects listed on the studio's
      current site; their stories and photographs would follow in a complete build.
    </p>
  </section>

  <section class="feature" aria-labelledby="feature-h" data-reveal>
    <div class="feature__plate">
      <Sketch name="lobby" weight={1.2} label="Drawing of a double-height lobby with a staircase and butterfly-shaped lights hanging from a mirrored ceiling." />
      <p class="plate-cap">Plate 01 · The lobby at Vijayshree. Drawn stand-in for the studio's photograph.</p>
    </div>
    <div class="feature__copy">
      <p class="eyebrow">Featured · West Nagpur, 2022</p>
      <h2 id="feature-h" class="title">Vijayshree</h2>
      <p>
        A family bungalow, two years in the making, where three generations each have a room that is recognisably
        theirs, and the house still reads as one. Butterflies hang in the lobby. A partition turns on its axis between
        living and dining. The terrace ends in a teak swing.
      </p>
      <p class="feature__pub">Published in The Architects Diary, April 2022.</p>
      <a class="btn btn--line" href={project}>Walk through the house</a>
    </div>
  </section>

  <section class="sectors" id="sectors" aria-labelledby="sectors-h">
    <header class="section-head">
      <p class="eyebrow">What we design</p>
      <h2 id="sectors-h" class="title">From a single room <em>to a hospital.</em></h2>
    </header>
    <ul class="sectors__list">
      {
        sectors.map((s, i) => (
          <li data-reveal style={`--i:${i}`}>
            <h3>{s.name}</h3>
            <p>{s.note}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="process" id="process" aria-labelledby="process-h">
    <header class="section-head">
      <p class="eyebrow">How we work</p>
      <h2 id="process-h" class="title">Tailored, planned, <em>then built with care.</em></h2>
    </header>
    <ol class="process__steps">
      {
        steps.map((s) => (
          <li data-reveal>
            <span class="process__n" aria-hidden="true">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="studio" id="studio" aria-labelledby="studio-h">
    <div class="studio__lead">
      <p class="eyebrow">The studio</p>
      <h2 id="studio-h" class="title">We do not settle <em>for ordinary.</em></h2>
      <div class="studio__art"><Sketch name="vFlat" weight={1.4} /></div>
    </div>
    <div class="studio__body">
      <p class="studio__intro">
        Nest was founded in Nagpur by two architects, and is still led by them. Around them is a team of ten to twelve:
        architects, an interior designer and a site supervisor, with hospital planning consultants and civil and
        structural designers as associates.
      </p>
      <ul class="studio__people">
        <li><span class="label">Founder</span><strong>Ar. Nikita Tahilyani</strong></li>
        <li><span class="label">Founder</span><strong>Ar. Vikram Singhania</strong></li>
      </ul>
      <dl class="studio__facts">
        <div><dt>Based</dt><dd>New Ramdaspeth, Nagpur</dd></div>
        <div><dt>Works across</dt><dd>India and abroad</dd></div>
        <div><dt>Team</dt><dd>10 to 12 people</dd></div>
      </dl>
    </div>
  </section>

  <section class="enquire" id="enquire" aria-labelledby="enquire-h">
    <div class="enquire__copy">
      <p class="eyebrow">Enquire</p>
      <h2 id="enquire-h" class="title">Tell us what you are <em>planning to build.</em></h2>
      <p>
        A few lines are enough to start: what the space is, where it is, and roughly when you would like to begin.
        The studio will come back to you.
      </p>
      <dl class="enquire__direct">
        <div><dt>Call or WhatsApp</dt><dd>{studio.phones.map((p) => <span>{p}</span>)}</dd></div>
        <div><dt>Email</dt><dd><span>{studio.email}</span></dd></div>
        <div><dt>Visit</dt><dd>{studio.address.map((l) => <span>{l}</span>)}</dd></div>
      </dl>
    </div>
    <form class="enquire__form" data-demo-form novalidate={false}>
      <p class="form-flag">Demonstration form. Nothing you type here is sent or saved.</p>
      <div class="field">
        <label for="f-name">Your name</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="f-contact">Phone or email</label>
        <input id="f-contact" name="contact" type="text" autocomplete="off" required />
      </div>
      <fieldset class="chips">
        <legend>What is the project?</legend>
        {
          ['A home', 'A shop', 'An office', 'A hotel or restaurant', 'A hospital', 'Something else'].map((c, i) => (
            <label><input type="radio" name="kind" value={c} checked={i === 0} /><span>{c}</span></label>
          ))
        }
      </fieldset>
      <div class="field">
        <label for="f-where">Where is it?</label>
        <input id="f-where" name="where" type="text" placeholder="City or neighbourhood" />
      </div>
      <div class="field">
        <label for="f-msg">Anything we should know</label>
        <textarea id="f-msg" name="message" rows="3"></textarea>
      </div>
      <button class="btn btn--solid btn--wide" type="submit">Send enquiry</button>
      <p class="form-note" data-form-note role="status" tabindex="-1" hidden></p>
    </form>
  </section>
</Base>
